---
import Badge from "./Badge.astro";
---

<h1 class="text-4xl font-semibold text-center mb-8 text-gray-800 dark:text-gray-200">Awards & Recognitions</h1>


  <!-- Award 1 2024-->
<div class="max-w-3xl mx-auto bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 mb-8">

  <div class="flex items-center cursor-pointer" id="award1-header">
    <div class="flex-1 pr-4">
      <time class="text-sm text-gray-400 dark:text-gray-500">October 2024</time>
      <h3 class="mt-1 text-xl font-semibold text-gray-900 dark:text-white">CENEVAL Informatics Award</h3>
      <p class="mt-2 text-base text-gray-500 dark:text-gray-400">
        Awarded for achieving the best Egel exam score in Informatics at a national level.
      </p>
      <div class="mt-4 space-x-2">
        <Badge>Informatics</Badge>
        <Badge>Excellence</Badge>
      </div>
    </div>
  </div>
  <!-- Accordion Content -->
  <div id="accordion-award1" class="mt-4 hidden">
    <img src="/Projects/EgelCENEVAL.webp" alt="CENEVAL Informatics Award Certificate" class="w-full h-auto rounded-lg">
  </div>
</div>

<!-- Award 2 - Curso de Lectura Veloz 2019 -->
<div class="max-w-3xl mx-auto bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 mb-8">
    <div class="flex items-center cursor-pointer" id="award4-header">
      <div class="flex-1 pr-4">
        <time class="text-sm text-gray-400 dark:text-gray-500">December 2019</time>
        <h3 class="mt-1 text-xl font-semibold text-gray-900 dark:text-white">Speed Reading Certification</h3>
        <p class="mt-2 text-base text-gray-500 dark:text-gray-400">
          Certified completion of "Learning Skills" program: Speed Reading, Memory Development and Learning Techniques.
        </p>
        <div class="mt-4 space-x-2">
          <Badge>Education</Badge>
          <Badge>Professional Development</Badge>
        </div>
      </div>
    </div>
    <div id="accordion-award4" class="mt-4 hidden">
      <img src="/Projects/Awards/Award2.webp" alt="Speed Reading Certification" class="w-full h-auto rounded-lg">
    </div>
  </div>


   <!-- Award 3 - Interpolitécnico Estadísticas 2019 -->
   <div class="max-w-3xl mx-auto bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 mb-8">
    <div class="flex items-center cursor-pointer" id="award9-header">
      <div class="flex-1 pr-4">
        <time class="text-sm text-gray-400 dark:text-gray-500">2018-2019</time>
        <h3 class="mt-1 text-xl font-semibold text-gray-900 dark:text-white">Statistics Academic Excellence</h3>
        <p class="mt-2 text-base text-gray-500 dark:text-gray-400">
          National 1st place in Probability and Statistics at Interpolytechnic Academic Meeting.
        </p>
        <div class="mt-4 space-x-2">
          <Badge>Statistics</Badge>
          <Badge>Excellence</Badge>
        </div>
      </div>
    </div>
    <div id="accordion-award9" class="mt-4 hidden">
      <img src="/Projects/Awards/Award3.webp" alt="Statistics Diploma" class="w-full h-auto rounded-lg">
    </div>
  </div>

  <!-- Award 4 - Interpolitécnico Cálculo 2018 -->
  <div class="max-w-3xl mx-auto bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 mb-8">
    <div class="flex items-center cursor-pointer" id="award8-header">
      <div class="flex-1 pr-4">
        <time class="text-sm text-gray-400 dark:text-gray-500">2017-2018</time>
        <h3 class="mt-1 text-xl font-semibold text-gray-900 dark:text-white">Calculus Academic Competition</h3>
        <p class="mt-2 text-base text-gray-500 dark:text-gray-400">
          7th place nationwide in Interpolytechnic Academic Meeting for Differential Calculus.
        </p>
        <div class="mt-4 space-x-2">

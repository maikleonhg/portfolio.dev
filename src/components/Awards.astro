    </div>
    <div id="accordion-award8" class="mt-4 hidden">
      <img src="/Projects/Awards/Award4.webp" alt="Calculus Competition Diploma" class="w-full h-auto rounded-lg">
    </div>
  </div>

  
  <!-- Award 5 - Concurso Cachi Cachi Porra 2018 -->
  <div class="max-w-3xl mx-auto bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 mb-8">
    <div class="flex items-center cursor-pointer" id="award6-header">
      <div class="flex-1 pr-4">
        <time class="text-sm text-gray-400 dark:text-gray-500">December 2018</time>
        <h3 class="mt-1 text-xl font-semibold text-gray-900 dark:text-white">Academic Excellence Award</h3>
        <p class="mt-2 text-base text-gray-500 dark:text-gray-400">
          First place in "A la Cachi Cachi Porra" national academic competition among IPN foreign units.
        </p>
        <div class="mt-4 space-x-2">
          <Badge>Academic Competition</Badge>
          <Badge>Leadership</Badge>
        </div>
      </div>
    </div>
    <div id="accordion-award6" class="mt-4 hidden">
      <img src="/Projects/Awards/Award5.webp" alt="Cachi Cachi Porra Certificate" class="w-full h-auto rounded-lg">
    </div>
  </div>
  
  <!-- Award 6 - Concurso Pierre Fermat 2017 -->
  <div class="max-w-3xl mx-auto bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 mb-8">
    <div class="flex items-center cursor-pointer" id="award7-header">
      <div class="flex-1 pr-4">
        <time class="text-sm text-gray-400 dark:text-gray-500">September 2017</time>
        <h3 class="mt-1 text-xl font-semibold text-gray-900 dark:text-white">Pierre Fermat Mathematics Contest</h3>
        <p class="mt-2 text-base text-gray-500 dark:text-gray-400">
          Finalist in XXII National Mathematics Competition representing UPIIH-IPN at high school level.
        </p>
        <div class="mt-4 space-x-2">
          <Badge>Mathematics</Badge>
          <Badge>National Competition</Badge>
        </div>
      </div>
    </div>
    <div id="accordion-award7" class="mt-4 hidden">
      <img src="/Projects/Awards/Award6.webp" alt="Pierre Fermat Certificate" class="w-full h-auto rounded-lg">
    </div>
  </div>

 <!-- Award 7 - Olimpiada Mexicana de Matemáticas 2017 -->
<div class="max-w-3xl mx-auto bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 mb-8">
    <div class="flex items-center cursor-pointer" id="award2-header">
      <div class="flex-1 pr-4">
        <time class="text-sm text-gray-400 dark:text-gray-500">March 2017</time>
        <h3 class="mt-1 text-xl font-semibold text-gray-900 dark:text-white">Mexican Mathematics Olympiad - 1st Place</h3>
        <p class="mt-2 text-base text-gray-500 dark:text-gray-400">
          Awarded 1st place in High School category at the 2017 Mexican Mathematics Olympiad, State Stage in Hidalgo.
        </p>
        <div class="mt-4 space-x-2">
          <Badge>Mathematics</Badge>
          <Badge>State Champion</Badge>
        </div>
      </div>
    </div>
    <div id="accordion-award2" class="mt-4 hidden">
      <img src="/Projects/Awards/Award7.webp" alt="2017 Mathematics Olympiad Diploma" class="w-full h-auto rounded-lg">
    </div>
  </div>
  
  <!-- Award 8 - Olimpiada Estatal de Matemáticas 2016 -->
  <div class="max-w-3xl mx-auto bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 mb-8">
    <div class="flex items-center cursor-pointer" id="award3-header">
      <div class="flex-1 pr-4">
        <time class="text-sm text-gray-400 dark:text-gray-500">March 2016</time>
        <h3 class="mt-1 text-xl font-semibold text-gray-900 dark:text-white">Mathematics State Olympiad - 1st Place</h3>
        <p class="mt-2 text-base text-gray-500 dark:text-gray-400">
          Achieved 1st place in Middle School category at the XXX Mexican Mathematics Olympiad, State Stage in Hidalgo.
        </p>
        <div class="mt-4 space-x-2">
          <Badge>Mathematics</Badge>
          <Badge>Academic Excellence</Badge>
        </div>
      </div>
    </div>
    <div id="accordion-award3" class="mt-4 hidden">
      <img src="/Projects/Awards/Award8.webp" alt="2016 State Mathematics Diploma" class="w-full h-auto rounded-lg">
    </div>
  </div>
  

<!-- Award 9 - Campeonato Nacional de Ajedrez 2015 -->
<div class="max-w-3xl mx-auto bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 mb-8">
    <div class="flex items-center cursor-pointer" id="award5-header">
      <div class="flex-1 pr-4">
        <time class="text-sm text-gray-400 dark:text-gray-500">April 2015</time>
        <h3 class="mt-1 text-xl font-semibold text-gray-900 dark:text-white">National Chess Championship</h3>
        <p class="mt-2 text-base text-gray-500 dark:text-gray-400">
          Participated in LXI Mexican National and International Chess Open Championship, representing Hidalgo. 23º
        </p>
        <div class="mt-4 space-x-2">
          <Badge>Chess</Badge>
          <Badge>International Event</Badge>
        </div>
      </div>
    </div>
    <div id="accordion-award5" class="mt-4 hidden">
      <img src="/Projects/Awards/Award9.webp" alt="National Chess Certificate" class="w-full h-auto rounded-lg">
    </div>
  </div>
 
  <!-- Award 10 - Campeonato Nacional Ajedrez 2012 -->
  <div class="max-w-3xl mx-auto bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 mb-8">
    <div class="flex items-center cursor-pointer" id="award10-header">
      <div class="flex-1 pr-4">
        <time class="text-sm text-gray-400 dark:text-gray-500">January 2012</time>
        <h3 class="mt-1 text-xl font-semibold text-gray-900 dark:text-white">National Chess Champion U12</h3>
        <p class="mt-2 text-base text-gray-500 dark:text-gray-400">
          1st place in U12 category at National Chess Olympiad Qualifiers, Hidalgo State.
        </p>
        <div class="mt-4 space-x-2">
          <Badge>Chess</Badge>
          <Badge>National Champion</Badge>
        </div>
      </div>
    </div>
    <div id="accordion-award10" class="mt-4 hidden">
      <img src="/Projects/Awards/Award10.webp" alt="Chess Champion Certificate" class="w-full h-auto rounded-lg">
    </div>
  </div>
  
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    // Añadir estos nuevos elementos al array existente
    const newAwards = [
    { header: 'award1-header', content: 'accordion-award1' },
      { header: 'award2-header', content: 'accordion-award2' },
      { header: 'award3-header', content: 'accordion-award3' },
      { header: 'award4-header', content: 'accordion-award4' },
      { header: 'award5-header', content: 'accordion-award5' },
      { header: 'award6-header', content: 'accordion-award6' },
      { header: 'award7-header', content: 'accordion-award7' },
      { header: 'award8-header', content: 'accordion-award8' },
      { header: 'award9-header', content: 'accordion-award9' },
      { header: 'award10-header', content: 'accordion-award10' }
    ];
  
    newAwards.forEach(({ header, content }) => {
      const headerElement = document.getElementById(header);
      const contentElement = document.getElementById(content);
      
      headerElement.addEventListener('click', () => {
        contentElement.classList.toggle('hidden');
      });
    });
  });
  </script>